# Mirrors huly-selfhost's .huly.nginx: one public origin, path-routed to the
# processes run.sh starts on localhost.
{
	auto_https off
	admin off
}

:{$PORT:8000} {
	request_body {
		max_size 100MB
	}

	handle_path /_accounts* {
		# account sets its session cookie on the parent domain (huly.example.com ->
		# .example.com). For *.up.railway.app that is a public suffix, so browsers drop
		# the cookie and every reload logs you out. A host-only cookie works everywhere.
		reverse_proxy 127.0.0.1:3000 {
			header_down Set-Cookie "(?i);\s*domain=[^;]*" ""
		}
	}
	handle_path /_transactor* {
		reverse_proxy 127.0.0.1:3333
	}
	handle_path /_collaborator* {
		reverse_proxy 127.0.0.1:3078
	}
	handle_path /_rekoni* {
		reverse_proxy 127.0.0.1:4004
	}
	handle_path /_stats* {
		reverse_proxy 127.0.0.1:4900
	}
	# Transactor endpoints addressed by token (JWTs start with eyJ).
	@token path_regexp ^/eyJ
	handle @token {
		reverse_proxy 127.0.0.1:3333
	}
	handle {
		reverse_proxy 127.0.0.1:8080
	}
}
